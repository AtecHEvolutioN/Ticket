# Public configuration for the signed Discord command endpoint.
# Add these values in the Vercel project's Production environment, then redeploy.
# No bot token or Ticketmaster key is needed by this hosted app.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to use /ticket commands.
DISCORD_ALLOWED_USER_IDS=
